# SMART ATTENDANCE SYSTEM USING FACE RECOGNITION
# Beginner Friendly Version

import cv2
import os
import csv
from datetime import datetime

# Create folders if not exist
if not os.path.exists("faces"):
    os.makedirs("faces")

# Load face detector
face_cascade = cv2.CascadeClassifier(
    cv2.data.haarcascades + "haarcascade_frontalface_default.xml"
)

# ================================
# STEP 1 : REGISTER NEW USER
# ================================

name = input("Enter Student Name: ")

cam = cv2.VideoCapture(0)

count = 0

print("Capturing face samples... Press Q to stop")

while True:
    ret, frame = cam.read()

    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)

    faces = face_cascade.detectMultiScale(gray, 1.3, 5)

    for (x, y, w, h) in faces:
        count += 1

        # Crop face
        face = gray[y:y+h, x:x+w]

        # Save image
        cv2.imwrite(f"faces/{name}_{count}.jpg", face)

        # Draw rectangle
        cv2.rectangle(frame, (x, y), (x+w, y+h), (0,255,0), 2)

    cv2.imshow("Register Face", frame)

    if cv2.waitKey(1) == ord('q') or count >= 20:
        break

cam.release()
cv2.destroyAllWindows()

print("Face samples saved successfully!")

# ================================
# STEP 2 : TRAIN MODEL
# ================================

recognizer = cv2.face.LBPHFaceRecognizer_create()

faces_data = []
labels = []

names = {}
current_id = 0

for file in os.listdir("faces"):
    if file.endswith(".jpg"):

        path = os.path.join("faces", file)

        img = cv2.imread(path, cv2.IMREAD_GRAYSCALE)

        student_name = file.split("_")[0]

        if student_name not in names:
            names[student_name] = current_id
            current_id += 1

        label = names[student_name]

        faces_data.append(img)
        labels.append(label)

recognizer.train(faces_data, __import__('numpy').array(labels))

recognizer.save("trainer.yml")

print("Model trained successfully!")

# ================================
# STEP 3 : ATTENDANCE SYSTEM
# ================================

recognizer.read("trainer.yml")

reverse_names = {v:k for k,v in names.items()}

cam = cv2.VideoCapture(0)

print("Attendance Started... Press Q to quit")

attendance_marked = set()

while True:
    ret, frame = cam.read()

    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)

    faces = face_cascade.detectMultiScale(gray, 1.3, 5)

    for (x, y, w, h) in faces:

        face = gray[y:y+h, x:x+w]

        label, confidence = recognizer.predict(face)

        if confidence < 70:

            student_name = reverse_names[label]

            if student_name not in attendance_marked:

                now = datetime.now()

                date = now.strftime("%d-%m-%Y")
                time = now.strftime("%H:%M:%S")

                with open("attendance.csv", "a", newline="") as f:
                    writer = csv.writer(f)
                    writer.writerow([student_name, date, time])

                attendance_marked.add(student_name)

                print(f"{student_name} Attendance Marked")

            text = f"{student_name}"

        else:
            text = "Unknown"

        cv2.rectangle(frame, (x, y), (x+w, y+h), (255,0,0), 2)

        cv2.putText(
            frame,
            text,
            (x, y-10),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.8,
            (0,255,0),
            2
        )

    cv2.imshow("Attendance System", frame)

    if cv2.waitKey(1) == ord('q'):
        break

cam.release()
cv2.destroyAllWindows()

print("Attendance saved in attendance.csv")
